# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Which Gemini model to use (default gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
# Agent wallet private key (0x...). TEST wallet only. Leave empty locally and use "Create wallet".
# REQUIRED on Vercel (the filesystem there is not persistent).
WALLET_PRIVATE_KEY=

# X data source: mock (paid fixture feed on Base Sepolia) | fetcher | official
X_SOURCE=mock
X_BEARER_TOKEN=
X402_MAINNET=false

# Budget guard for x402 payments
DAILY_BUDGET_USD=0.50
MAX_PRICE_PER_CALL_USD=0.01
# Triage: drop updates scoring below this (0-100)
RELEVANCE_THRESHOLD=60

# Upstash Redis (production store). Leave empty to use .data/store.json locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret for POST /api/cycle (scheduler)
CYCLE_SECRET=
# Phase 2: wa-bridge (Baileys) service
WA_BRIDGE_URL=
BRIDGE_SECRET=

# Optional: Gemini-generated abstract poster backgrounds
POSTER_AI_BACKGROUND=false
