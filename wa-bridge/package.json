{
  "name": "crier-wa-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on WhatsApp Web bridge for Crier (Baileys). Unofficial client: use a dedicated number.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "node-cron": "4.6.0",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
