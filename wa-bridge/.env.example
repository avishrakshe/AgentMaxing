PORT=8787
# Same value as BRIDGE_SECRET in the Next.js app
BRIDGE_SECRET=
# Your deployed Crier app, e.g. https://crier.vercel.app
APP_URL=
# Same value as CYCLE_SECRET in the Next.js app
CYCLE_SECRET=
# Admins who approve drafts over WhatsApp DM (international format, comma separated)
ADMIN_NUMBERS=
# Optional: link by pairing code instead of QR (the bridge's own dedicated number)
WA_PAIRING_NUMBER=
# Auth + state folder. Mount a persistent volume here in production.
AUTH_DIR=auth
MAX_PER_DAY=6
CRON=*/30 * * * *
